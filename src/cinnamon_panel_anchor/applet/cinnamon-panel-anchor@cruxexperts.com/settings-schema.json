{
  "section-status": {
    "type": "section",
    "description": "Status and notifications"
  },
  "show-notifications": {
    "type": "switch",
    "default": true,
    "description": "Show attention notifications"
  },
  "refresh-interval": {
    "type": "spinbutton",
    "default": 30,
    "min": 10,
    "max": 300,
    "step": 5,
    "description": "Refresh interval",
    "units": "seconds"
  },
  "restore-automatically": {
    "type": "switch",
    "default": false,
    "description": "Restore automatically when drift is detected"
  },
  "section-startup": {
    "type": "section",
    "description": "Startup"
  },
  "legacy-autostart-watcher": {
    "type": "switch",
    "default": false,
    "description": "Run legacy autostart watcher at login"
  },
  "section-debug": {
    "type": "section",
    "description": "Diagnostics"
  },
  "debug-logging": {
    "type": "switch",
    "default": true,
    "description": "Debug logging"
  }
}
